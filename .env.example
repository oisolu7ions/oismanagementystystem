# PostgreSQL over TCP (required by Prisma). Use your OS user + password you set via:
#   sudo -u postgres psql -c "ALTER USER YOUR_USER WITH PASSWORD 'your_password';"
DATABASE_URL="postgresql://powolabi:your_password@localhost:5432/ois_command_center?schema=public"

# Session signing secret — use a long random string in production
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Default admin created by seed (override in production)
ADMIN_EMAIL="admin@ois.tech"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="OIS Admin"

# Client portal email delivery
# APP_URL stays in .env so verification links resolve correctly.
# Provider mode, From, Reply-To, and test recipient are non-secret admin settings in /dashboard/settings.
APP_URL="http://localhost:3000"

# Optional legacy/status hints; active provider mode is stored in admin settings.
EMAIL_PROVIDER="console"
EMAIL_FROM="OIS Management Center <no-reply@localhost>"

# SMTP provider secrets for staging/production when admin settings use smtp mode
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
