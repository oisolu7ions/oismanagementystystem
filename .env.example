# PostgreSQL over TCP (required by Prisma). Use your OS user + password you set via:
#   sudo -u postgres psql -c "ALTER USER YOUR_USER WITH PASSWORD 'your_password';"
DATABASE_URL="postgresql://powolabi:your_password@localhost:5432/ois_command_center?schema=public"

# Session signing secret — use a long random string in production
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Default admin created by seed (override in production)
ADMIN_EMAIL="admin@ois.tech"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="OIS Admin"
