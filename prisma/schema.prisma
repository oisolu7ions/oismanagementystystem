// OIS Management Center — domain schema (lifecycle-ready for later phases)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum LeadStatus {
  NEW
  CONTACTED
  CONSULTATION_SCHEDULED
  PROPOSAL_SENT
  WON
  LOST
}

enum LeadSource {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  REFERRAL
  WEBSITE_FORM
  COLD_EMAIL
  IN_PERSON
  OTHER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PAST_CLIENT
  PROSPECT
}

enum ProjectStatus {
  NOT_STARTED
  DISCOVERY
  DESIGN
  DEVELOPMENT
  REVIEW
  WAITING_ON_CLIENT
  COMPLETED
  PAUSED
  CANCELLED
}

enum ServiceType {
  WEBSITE_BUILD
  WEBSITE_REDESIGN
  CRM_INTEGRATION
  EMAIL_AUTOMATION
  BOOKING_SYSTEM
  DASHBOARD
  AI_BUSINESS_SYSTEM
  WEB_APP
  DIGITAL_INFRASTRUCTURE
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceRecurrenceInterval {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
  CANCELLED
}

enum FollowUpReason {
  CONSULTATION_REMINDER
  PROPOSAL_FOLLOW_UP
  PAYMENT_REMINDER
  MISSING_CONTENT_REMINDER
  WEBSITE_REVIEW_REMINDER
  MONTHLY_CHECK_IN
  RENEWAL_REMINDER
  OTHER
}

enum DocumentFileType {
  CONTRACT
  PROPOSAL
  INVOICE
  LOGO
  BRANDING
  IMAGES
  WEBSITE_COPY
  ACCESS_CREDENTIALS
  MEETING_NOTES
  PROJECT_BRIEF
  LEGAL_DOCUMENT
  OTHER
}

enum DocumentSourceType {
  LINK
  FILE
}

enum ActivityType {
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_CONVERTED
  CLIENT_CREATED
  CLIENT_UPDATED
  PROJECT_CREATED
  PROJECT_UPDATED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  INVOICE_CREATED
  INVOICE_UPDATED
  INVOICE_SENT
  INVOICE_PAID
  FOLLOW_UP_CREATED
  FOLLOW_UP_UPDATED
  FOLLOW_UP_COMPLETED
  NOTE_CREATED
  NOTE_UPDATED
  DOCUMENT_CREATED
  DOCUMENT_UPDATED
  UPDATE_REQUEST_CREATED
  UPDATE_REQUEST_UPDATED
  UPDATE_REQUEST_STATUS_CHANGED
  UPDATE_REQUEST_COMPLETED
  UPDATE_REQUEST_ATTACHMENT_ADDED
}

enum UpdateRequestType {
  WEBSITE_CONTENT_UPDATE
  WEBSITE_DESIGN_UPDATE
  WEBSITE_BUG_FIX
  NEW_WEBSITE_PAGE
  FORM_UPDATE
  SYSTEM_FEATURE_REQUEST
  DASHBOARD_UPDATE
  AUTOMATION_UPDATE
  CLIENT_PORTAL_UPDATE
  FILE_ASSET_UPDATE
  GENERAL_SUPPORT
  OTHER
}

enum UpdateRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SettingValueType {
  STRING
  BOOLEAN
  NUMBER
  JSON
}

enum SecurityEventType {
  CLIENT_USER_CREATED
  VERIFICATION_EMAIL_SENT
  EMAIL_VERIFIED
  VERIFICATION_FAILED
  LOGIN_PASSWORD_SUCCESS
  LOGIN_PASSWORD_FAILED
  LOGIN_CODE_SENT
  LOGIN_CODE_SUCCESS
  LOGIN_CODE_FAILED
  LOGIN_CODE_EXPIRED
  LOGIN_SUCCESS
  LOGIN_BLOCKED_UNVERIFIED_EMAIL
  LOGOUT
  RATE_LIMITED
  ADMIN_SETTING_CHANGED
  TEST_EMAIL_SENT
  ADMIN_LOGIN_SUCCESS
  ADMIN_LOGIN_FAILED
  FILE_UPLOAD_ACCEPTED
  FILE_UPLOAD_REJECTED
  SESSION_REVOKED
  SESSION_EXPIRED
  CLIENT_PASSWORD_RESET_BY_ADMIN
}

enum UpdateRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_MORE_INFORMATION
  APPROVED
  SCHEDULED
  IN_PROGRESS
  WAITING_ON_CLIENT
  COMPLETED
  DECLINED
  CANCELLED
}

model Setting {
  id          String           @id @default(cuid())
  key         String           @unique
  value       String           @db.Text
  type        SettingValueType @default(STRING)
  group       String
  description String?          @db.Text
  isSecret    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([group])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTasks Task[] @relation("AssignedTasks")
  notes         Note[]
  adminSessions AdminSession[]
  securityEvents SecurityEvent[]
}

model Lead {
  id              String      @id @default(cuid())
  name            String
  businessName    String?
  email           String?
  phone           String?
  website         String?
  industry        String?
  serviceInterest String?
  leadSource      LeadSource?
  status          LeadStatus  @default(NEW)
  notes           String?     @db.Text
  followUpDate    DateTime?
  clientId        String?     @unique
  convertedAt     DateTime?
  client          Client?     @relation(fields: [clientId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  activities Activity[]
  followUps  FollowUp[]
}

model Client {
  id            String       @id @default(cuid())
  name          String
  businessName  String?
  email         String?
  phone         String?
  website       String?
  address       String?      @db.Text
  status        ClientStatus @default(ACTIVE)
  packageId     String?
  package       Package?     @relation(fields: [packageId], references: [id])
  monthlyPlan   String?
  monthlyAmount String?
  notes         String?      @db.Text
  lead          Lead?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  projects      Project[]
  invoices      Invoice[]
  noteRecords   Note[]
  activities    Activity[]
  followUps     FollowUp[]
  documentLinks DocumentLink[]
  clientUsers   ClientUser[]
  updateRequests UpdateRequest[]
}

model ClientUser {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  emailVerifiedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  updateRequests UpdateRequest[]
  uploadedAttachments UpdateRequestAttachment[]
  emailVerificationTokens ClientEmailVerificationToken[]
  loginCodes ClientLoginCode[]
  securityEvents SecurityEvent[]
  portalSessions ClientPortalSession[]
}

model ClientEmailVerificationToken {
  id           String     @id @default(cuid())
  clientUserId String
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([clientUserId, createdAt])
  @@index([expiresAt])
}

model ClientLoginCode {
  id           String     @id @default(cuid())
  clientUserId String
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  codeHash     String
  expiresAt    DateTime
  usedAt       DateTime?
  attempts     Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([clientUserId, createdAt])
  @@index([expiresAt])
}

model SecurityEvent {
  id           String            @id @default(cuid())
  userId       String?
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientUserId String?
  clientUser   ClientUser?       @relation(fields: [clientUserId], references: [id], onDelete: SetNull)
  type         SecurityEventType
  ipAddress    String?
  userAgent    String?           @db.Text
  message      String            @db.Text
  metadata     Json?
  createdAt    DateTime          @default(now())

  @@index([clientUserId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model AdminSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model ClientPortalSession {
  id           String     @id @default(cuid())
  clientUserId String
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  clientId     String
  expiresAt    DateTime
  lastSeenAt   DateTime   @default(now())
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([clientUserId, revokedAt])
  @@index([clientId])
  @@index([expiresAt])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  scope     String
  key       String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, key])
  @@index([resetAt])
}

model Package {
  id           String   @id @default(cuid())
  name         String
  setupPrice   String
  monthlyPrice String
  description  String?  @db.Text
  features     String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clients  Client[]
  projects Project[]
}

model Project {
  id          String        @id @default(cuid())
  name        String
  serviceType ServiceType
  description String?       @db.Text
  status      ProjectStatus @default(NOT_STARTED)
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  packageId   String?
  package     Package?      @relation(fields: [packageId], references: [id])
  price       String?
  monthlyFee  String?
  startDate   DateTime?
  dueDate     DateTime?
  clientVisible    Boolean   @default(false)
  clientSummary    String?   @db.Text
  clientStatusNote String?   @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks         Task[]
  invoices      Invoice[]
  notes         Note[]
  activities    Activity[]
  documentLinks DocumentLink[]
  updateRequests UpdateRequest[]
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?        @relation("AssignedTasks", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  completedAt DateTime?
  clientVisible Boolean    @default(false)
  clientNote    String?    @db.Text
  updateRequestId String?  @unique
  updateRequest   UpdateRequest? @relation(fields: [updateRequestId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  activities Activity[]
}

model Invoice {
  id                 String                     @id @default(cuid())
  invoiceNumber      String                     @unique
  amount             String
  status             InvoiceStatus              @default(DRAFT)
  dueDate            DateTime?
  paidAt             DateTime?
  paymentLink        String?
  notes              String?                    @db.Text
  isRecurring        Boolean                    @default(false)
  recurrenceInterval InvoiceRecurrenceInterval?
  clientVisible      Boolean                    @default(true)
  clientNote         String?                    @db.Text
  clientId           String
  client             Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId          String?
  project            Project?                   @relation(fields: [projectId], references: [id])
  receipts           Receipt[]
  activities         Activity[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
}

model Receipt {
  id               String   @id @default(cuid())
  receiptNumber    String   @unique
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount           String
  paidAt           DateTime
  billingPeriod    String?
  clientName       String
  clientBusiness   String?
  clientEmail      String?
  clientVisible    Boolean  @default(false)
  storedFileName   String
  originalFileName String
  mimeType         String   @default("application/pdf")
  fileSize         Int
  createdAt        DateTime @default(now())

  @@unique([invoiceId, billingPeriod])
}

model FollowUp {
  id           String           @id @default(cuid())
  reason       FollowUpReason
  notes        String?          @db.Text
  status       FollowUpStatus   @default(PENDING)
  followUpDate DateTime
  completedAt  DateTime?
  leadId       String?
  lead         Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  activities   Activity[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  title     String?
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Activity {
  id             String       @id @default(cuid())
  type           ActivityType
  message        String
  clientVisible  Boolean      @default(false)
  clientMessage  String?      @db.Text
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  followUpId     String?
  followUp       FollowUp?    @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  noteId         String?
  note           Note?        @relation(fields: [noteId], references: [id], onDelete: Cascade)
  documentLinkId String?
  documentLink   DocumentLink? @relation(fields: [documentLinkId], references: [id], onDelete: Cascade)
  updateRequestId String?
  updateRequest   UpdateRequest? @relation(fields: [updateRequestId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model DocumentLink {
  id               String             @id @default(cuid())
  name             String
  fileType         DocumentFileType
  sourceType       DocumentSourceType @default(LINK)
  url              String?
  storedFileName   String?
  originalFileName String?
  mimeType         String?
  fileSize         Int?
  notes            String?            @db.Text
  clientVisible    Boolean            @default(false)
  clientDescription String?           @db.Text
  clientId         String?
  client           Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities       Activity[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model UpdateRequest {
  id                      String                 @id @default(cuid())
  clientId                String
  client                  Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId               String?
  project                 Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requestedByClientUserId String?
  requestedByClientUser   ClientUser?            @relation(fields: [requestedByClientUserId], references: [id], onDelete: SetNull)
  title                   String
  requestType             UpdateRequestType
  priority                UpdateRequestPriority  @default(NORMAL)
  status                  UpdateRequestStatus    @default(SUBMITTED)
  description             String                 @db.Text
  adminNotes              String?                @db.Text
  clientVisibleResponse   String?                @db.Text
  estimatedPrice          String?
  approvedPrice           String?
  dueDate                 DateTime?
  completedAt             DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  attachments UpdateRequestAttachment[]
  activities  Activity[]
  linkedTask  Task?
}

model UpdateRequestAttachment {
  id                       String         @id @default(cuid())
  updateRequestId          String
  updateRequest            UpdateRequest  @relation(fields: [updateRequestId], references: [id], onDelete: Cascade)
  fileName                 String?
  fileType                 String?
  fileSize                 Int?
  storedFileName           String?
  mimeType                 String?
  fileUrl                  String?
  externalUrl              String?
  notes                    String?        @db.Text
  uploadedByClientUserId   String?
  uploadedByClientUser     ClientUser?    @relation(fields: [uploadedByClientUserId], references: [id], onDelete: SetNull)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
}
